# SoundCloud API credentials
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed
#
# Register your app at https://soundcloud.com/you/apps
# Set redirect URI to: http://localhost:3000/soundcloud/callback (dev)
#                   or: https://your-domain.com/soundcloud/callback (prod)
REACT_APP_SC_CLIENT_ID=
REACT_APP_SC_CLIENT_SECRET=
